# Copy to backend/.env and fill in. Leave CHROMASWARM_LLM_MODEL empty to use the
# rule-based consultant (no LLM, no cost). Never commit backend/.env.

# --- OpenRouter (one key, any model listed at https://openrouter.ai/models) ---
CHROMASWARM_LLM_BASE_URL=https://openrouter.ai/api/v1
CHROMASWARM_LLM_API_KEY=sk-or-your-openrouter-key

# Model per role. Code and vision fall back to the text model when left empty.
CHROMASWARM_LLM_MODEL=qwen/qwen3.8-flash              # B1-B7: reads answers, B7 feedback, B5 prose
CHROMASWARM_LLM_MODEL_CODE=qwen/qwen3-coder-next      # B9: copy / codegen
CHROMASWARM_LLM_MODEL_VISION=qwen/qwen3.8-flash       # Clone mode from screenshots (must accept images)
# Stronger alternatives: anthropic/claude-sonnet-5.5, anthropic/claude-opus-5.5, qwen/qwen3.8-max-0902

# Optional JSON merged into every request; overrides the automatic per-model settings
# (reasoning off where allowed, lowest effort where mandatory).
# CHROMASWARM_LLM_EXTRA_BODY={"reasoning": {"effort": "low"}}
CHROMASWARM_LLM_TIMEOUT=60

# --- Other OpenAI-compatible providers (replace the three lines above) ---
# DashScope:  CHROMASWARM_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#             CHROMASWARM_LLM_MODEL=qwen3.8-flash   CHROMASWARM_LLM_EXTRA_BODY={"enable_thinking": false}
# Ollama:     CHROMASWARM_LLM_BASE_URL=http://localhost:11434/v1   CHROMASWARM_LLM_API_KEY=ollama

# --- Build (B8-B12) ---
# CHROMASWARM_BUILD=0        # stop after the B7 approval (no Next.js workspace, no browser)
# CHROMASWARM_HEADED=0       # run Playwright hidden (much faster; no swarm cursors on screen)
# CHROMASWARM_MOTION_MCP="npx some-motion-mcp"   # external B8.1 MCP server with the build_effect tool

# --- Sessions ---
# CHROMASWARM_STATE_DB=../workspaces/.state/sessions.sqlite   # default; set empty to keep sessions in memory only

# --- Photos ---
# UNSPLASH_ACCESS_KEY=        # photo bot: Unsplash API (unsplash.com/developers); without it Openverse + Wikimedia
# CHROMASWARM_IMAGE_MODEL=    # last resort when no real photo fits: an image-output model on the same provider,
#                             # e.g. google/gemini-2.5-flash-image (images are labelled as AI-generated)

# --- Art director (Creative: composition at B10, critic-driven refine at B11; uses the code model) ---
# CHROMASWARM_STYLIST=0       # turn it off (templates only)

# --- Publish (Studio buttons after handover; your own tokens, never committed) ---
# VERCEL_TOKEN=               # vercel.com/account/tokens
# VERCEL_TEAM_ID=             # optional, deploy under a team
# GITHUB_TOKEN=               # github.com/settings/tokens, scope: repo (creates a private repository)
# CHROMASWARM_SECTION_EYE=0    # B9: no per-section screenshot check (faster builds)
# CHROMASWARM_COMPOSE=1       # B10 blind composition layer (off by default)

# Clone mode history in Supabase (sessions, conversation, Chroma's activity). Server-side only: use the
# service-role key, never expose it to the Studio. Leave empty to keep history in memory only.
# Create the tables with supabase/migrations/20261120000000_clone_history.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
