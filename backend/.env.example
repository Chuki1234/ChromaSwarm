# Copy to backend/.env and fill in. Leave CHROMASWARM_LLM_MODEL empty to use the
# rule-based consultant (no LLM, no cost).

CHROMASWARM_LLM_MODEL=qwen3.8-flash

# --- Option A: Alibaba Cloud Model Studio / DashScope (international endpoint) ---
CHROMASWARM_LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
CHROMASWARM_LLM_API_KEY=sk-your-dashscope-key
# Qwen3 hybrid-thinking models: turn thinking off for short, cheap classification calls
CHROMASWARM_LLM_EXTRA_BODY={"enable_thinking": false}

# --- Option B: OpenRouter ---
# CHROMASWARM_LLM_BASE_URL=https://openrouter.ai/api/v1
# CHROMASWARM_LLM_API_KEY=sk-or-...
# CHROMASWARM_LLM_MODEL=qwen/<model-id-as-listed-on-openrouter>

# --- Option C: local Ollama (no key needed) ---
# CHROMASWARM_LLM_BASE_URL=http://localhost:11434/v1
# CHROMASWARM_LLM_API_KEY=ollama
# CHROMASWARM_LLM_MODEL=<tag shown by `ollama list`>

CHROMASWARM_LLM_TIMEOUT=30

# --- Build (B8-B12) ---
# CHROMASWARM_BUILD=0        # stop after the B7 approval (no Next.js workspace, no browser)
# CHROMASWARM_HEADED=0       # run Playwright hidden (much faster; no swarm cursors on screen)
# CHROMASWARM_MOTION_MCP="npx some-motion-mcp"   # external B8.1 MCP server with the build_effect tool
